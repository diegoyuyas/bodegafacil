{
  "name": "vende-facil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run sync:esquema",
    "dev": "next dev",
    "prebuild": "npm run sync:esquema",
    "build": "next build",
    "prebuild:apk": "npm run sync:esquema",
    "build:apk": "cross-env BUILD_CAPACITOR=1 next build && npx cap sync android",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sync:esquema": "node scripts/generar-esquema-ts.mjs",
    "postinstall": "node scripts/copiar-sql-wasm.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@noble/ed25519": "^2.3.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "^1.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "10.4.19",
    "cross-env": "^10.1.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "tsx": "^4.23.13",
    "typescript": "5.5.3"
  }
}
